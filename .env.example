# TeachGage Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# ============================================
# Next-Auth Configuration
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# ============================================
# Backend API Configuration
# ============================================

# NEXT_PUBLIC_API_URL is exposed to the browser (client-side)
# This is the URL where your TeachGage backend API is hosted
# Development: http://localhost:5000
# Production: https://api.teachgage.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# BACKEND_URL is for server-side API calls only (not exposed to browser)
# Same as NEXT_PUBLIC_API_URL but used in server-side rendering
BACKEND_URL=http://localhost:5000

# ============================================
# Environment
# ============================================
NODE_ENV=development

# ============================================
# Optional Configuration
# ============================================

# API Request Timeout (milliseconds)
# Default: 30000 (30 seconds)
API_TIMEOUT=30000

# ============================================
# Production Environment Variables
# ============================================
#
# For production deployment, update the following:
#
# NEXTAUTH_URL=https://app.teachgage.com
# NEXTAUTH_SECRET=<generate-strong-secret-key>
# NEXT_PUBLIC_API_URL=https://api.teachgage.com
# BACKEND_URL=https://api.teachgage.com
# NODE_ENV=production
#
# ============================================

# ============================================
# Notes
# ============================================
#
# 1. NEXT_PUBLIC_* variables are exposed to the browser
#    - Use these for client-side API calls
#    - Never put secrets in NEXT_PUBLIC_* variables
#
# 2. Variables without NEXT_PUBLIC_ prefix are server-side only
#    - These are NOT accessible in the browser
#    - Safe for sensitive information
#
# 3. After changing environment variables:
#    - Stop the development server (Ctrl+C)
#    - Restart with: npm run dev
#
# 4. For production:
#    - Use environment variable management in your hosting platform
#    - Never commit .env.local to version control
#    - Rotate secrets regularly
#
# ============================================
